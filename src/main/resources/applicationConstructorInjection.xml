<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="CarSpecification" class="car.example.constructor.injection.Specification">
        <property name="model" value="Tesla"/>
        <property name="make" value="TOS_EV"/>
    </bean>


    <bean id="myCarId" class="car.example.constructor.injection.Car">
        <constructor-arg ref="CarSpecification"/>
    </bean>

</beans>